# Quem faz o papel do modelo:
#   local     -> motor por regras: gratuito, offline, não precisa de nada (padrão)
#   ollama    -> LLM local gratuito (https://ollama.com), precisa do Ollama rodando
#   anthropic -> Claude via API: pago, precisa de ANTHROPIC_API_KEY
PROVEDOR=local

# Ollama (só para PROVEDOR=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Anthropic (só para PROVEDOR=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-5-5
# EFFORT=medium
# MAX_TOKENS=16000
# USAR_FALLBACK=true

# Gerais (valores padrão)
MAX_ITERACOES=8
MAX_MENSAGENS_HISTORICO=40
MAX_TENTATIVAS_API=4
TIMEOUT_API_S=60
TIMEOUT_TRANSPORTADORA_S=5
LOG_LEVEL=WARNING
